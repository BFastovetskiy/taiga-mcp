# ---------------------------------------------------------------------------
# Контекст сборки Docker для MCP-сервера Taiga.
# Цель — не тащить в образ артефакты сборки, секреты и сертификаты.
# ---------------------------------------------------------------------------

# Результаты сборки и IDE
**/bin/
**/obj/
.vs/
.vscode/
.idea/

# Тесты и покрытие (в образ не нужны)
tests/
TestResults/
*.trx
*.coverage
*.coveragexml

# Секреты и локальные настройки — монтируются при запуске, а не встраиваются
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.secrets.json
.env

# Сертификаты — монтируются при запуске
certs/
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer

# Служебное
.git/
.gitignore
*.md
Dockerfile
.dockerignore
docker-compose*.yml
