{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Server": {
    "Host": "0.0.0.0",
    "Port": 5000
  },
  "Mcp": {
    "AuthToken": ""
  },
  "Audit": {
    "Enabled": true,
    "FilePath": "logs/audit.log",
    "MaxFileSizeMB": 64,
    "MaxBackupFiles": 5
  },
  "Health": {
    "ReadyCacheSeconds": 60
  },
  "Metrics": {
    "Enabled": true,
    "Path": "/metrics"
  },
  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Shutdown": {
    "ShutdownTimeoutSeconds": 30,
    "ShutdownOnUnhandledException": true
  },
  "Taiga": {
    "BaseUrl": "https://api.taiga.io/api/v1",
    "Username": "",
    "Password": "",
    "Token": "",
    "RefreshToken": "",
    "AuthMethod": "auto",
    "Cookie": "",
    "AuthScheme": "Bearer",
    "CaCertificatePath": "",
    "IgnoreSslErrors": false,
    "DisablePaginationByDefault": true,
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryBaseDelayMs": 500
  }
}
